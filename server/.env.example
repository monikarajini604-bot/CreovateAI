# CREOVATE AI - Node.js/Express Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
ENVIRONMENT=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/creovate_ai

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=creovate-jwt-secret-key-2026-change-in-production
JWT_EXPIRY=7d

# Email Service (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=CREOVATE AI <noreply@creovate.ai>

# Python AI Backend URL (for proxying AI requests)
PYTHON_AI_BACKEND=http://127.0.0.1:8000