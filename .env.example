# ==============================================================================
# CREOVATE AI — EXAMPLE MASTER CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

PORT=5000
HOST=127.0.0.1
NODE_ENV=development
ENVIRONMENT=development

# MongoDB Atlas URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.cehle7m.mongodb.net/creovate_ai?retryWrites=true&w=majority"

# JWT Secret & Expiry
JWT_SECRET=creovate-jwt-secret-key-2026-dev
JWT_EXPIRY=7d

# Frontend & Application URLs
APP_URL=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:5000
BACKEND_URL=http://127.0.0.1:5000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# Python AI Backend
PYTHON_HOST=127.0.0.1
PYTHON_PORT=8000
PYTHON_AI_BACKEND=http://127.0.0.1:8000
NODEJS_BACKEND=http://127.0.0.1:5000

# Google Gemini API Key
GEMINI_API_KEY=

# Email SMTP Settings (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CREOVATE AI" <noreply@creovate.ai>
