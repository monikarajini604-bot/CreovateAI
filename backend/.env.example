# CREOVATE AI - Python/FastAPI Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS - Allow frontend and Node.js backend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# Google Gemini API Key for Live AI Brief Generation
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Node.js Backend URL (for cross-backend communication)
NODEJS_BACKEND=http://127.0.0.1:5000